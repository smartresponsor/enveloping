{
  "name": "enveloping/envelope",
  "description": "Symfony-oriented contextual envelope primitives",
  "type": "symfony-bundle",
  "license": "PolyForm-Noncommercial-1.0.0",
  "require": {
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/console": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": ">=3.95 <4.0",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "symfony/messenger": "^8.1"
  },
  "suggest": {
    "symfony/messenger": "Enables the optional Symfony Messenger bridge for Envelope context stamps."
  },
  "autoload": {
    "psr-4": {
      "App\\Enveloping\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Enveloping\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "validate:prod": "composer validate --strict --no-check-all composer.prod.json",
    "phpstan": "phpstan analyse src tests --memory-limit=1G",
    "test": "phpunit --testdox",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": ["@cs:check", "@phpstan", "@test", "@gate"]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "extra": {
    "symfony": {
      "require": "^8.1"
    }
  }
}
